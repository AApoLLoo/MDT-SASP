# Copiez ce fichier en .env puis remplissez les valeurs. Ne commitez jamais .env.
# Toutes les variables sont facultatives : voir le tableau du README.

PORT=3000
# 127.0.0.1 derrière Nginx/Caddy ; vide = accessible sur le réseau.
HOST=

# --- MDT : premier administrateur (utilisé au premier lancement uniquement ; vide = mot de passe généré)
ADMIN_MATRICULE=admin
ADMIN_PASSWORD=

# --- Sauvegardes : copie hors du disque des données (lecteur réseau, dossier synchronisé). Vide = aucune copie.
BACKUP_COPY_DIR=

# --- Site public
# Mot de passe de secours de /admin. Le commandement du MDT (superviseurs, administrateurs) y accède déjà avec son compte.
SITE_ADMIN_PASSWORD=
# Salon Discord des candidatures, et des demandes civiles (vide = même salon).
DISCORD_WEBHOOK_URL=
DISCORD_TICKETS_WEBHOOK_URL=
# Adresse publique, pour les liens des notifications Discord.
SITE_URL=http://localhost:3000

# --- Derrière un reverse proxy HTTPS
TRUST_PROXY=
SECURE_COOKIES=false
